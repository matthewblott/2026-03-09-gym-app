<% content_for :title, 'Exercises' %>

<style>
  p {
    text-align: center;
  }
  article {
    a {
      width: 100%;
      display: flex;
      justify-content: space-between;
      padding: 0 2rem;
      align-items: center;

      div {
        display: flex;
        flex-direction: column;
        h2 {
          color: color-mix(in srgb, var(--color-primary), black 30%);
          font-size: xx-large;
        }
        h3 {
          font-size: large;
          color: grey;
        }
      }
    }
  }
</style>

<% content_for :header_controls do %>
  <div role=group>
    <a href= <%= user_workouts_path(Current.user) %> role=button>Workouts</a>
    <a href= <%= user_new_workout_exercise_path(Current.user, workout_id: @workout_id) %> role=button>New</a>
  </div>
<% end %>

<% @workout_exercises.each do |workout_exercise| %>
  <article class="pill">
    <a href="<%= user_sets_path(Current.user, workout_exercise) %>">
      <div>
        <h2><%= workout_exercise.name %></h2>
        <% if workout_exercise.weights? %>
          <h3><%= pluralize(workout_exercise.sets.count, "set") %></h3>
        <% else %>
          <h3><%= workout_exercise.sets.first.distance %> km</h3>
        <% end %>
      </div>
      <% if workout_exercise.weights? %>
        <img src="<%= asset_path 'icons/dumbbell.svg' %>"
          alt="Dumbbell"
          width="48"
          height="48">
      <% else %>
        <img src="<%= asset_path 'icons/cardio.svg' %>"
          alt="Cardio"
          width="48"
          height="48">
      <% end %>
    </a>
  </article>
<% end %>
