<style>
  label {
    span {
      margin-left: 0.5rem;
    }
    input, select {
      margin-top: 0.5rem;
    }
  }

  [role="radiogroup"] { 
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
  }

</style>

<form method=post id=exercise-form>
  <input type=hidden name=authenticity_token value= <%= form_authenticity_token %>>
  <fieldset>
    <div>
      <label>
        <span>Name</span>
        <input
          form="exercise-form"
          id="name"
          name=exercise[name]
          value="<%= exercise.name %>"
          placeholder="Bench press"
          aria-label="Exercise name"
          required
        >
      </label>
    </div>
    <div role="radiogroup">
      <span>Exercise Type</span>
      <label>
        <input
          form="exercise-form"
          type="radio"
          name=exercise[exercise_type]
          value="cardio"
          required
          <% if exercise.exercise_type == 'cardio' %>checked<% end %>
        >
        Cardio
      </label>
      <label>
        <input
          form="exercise-form"
          type="radio"
          name="exercise[exercise_type]"
          value="weights"
          <% if exercise.exercise_type == 'weights' %>checked<% end %>
        >
        Weights
      </label>
    </div>
  </fieldset>
</form>
